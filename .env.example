# Copy this file to ".env" for local development:   cp .env.example .env
# Never commit ".env" (it is already in .gitignore).

PORT=3000
NODE_ENV=development

# ---- WHERE YOUR DATA LIVES -------------------------------------------------
# Local development: the defaults below are fine (a "data" folder inside the project).
DATABASE_PATH=./data/wod.db
UPLOAD_DIR=./data/uploads

# On Render these MUST point inside your Persistent Disk mount (e.g. /var/data):
#   DATABASE_PATH=/var/data/wod.db
#   UPLOAD_DIR=/var/data/uploads
#   BACKUP_DIR=/var/data/backups
# If they don't, the server refuses to start on Render (so you never lose data silently).

# Optional
# SESSION_HOURS=12           # how long an admin stays signed in
# MAX_UPLOAD_MB=8            # per-image upload limit
# MAX_MEDIA_MB=200           # per-file limit for sermon audio/video uploads
# BACKUP_DIR=./backups       # where "npm run backup" writes
# SETUP_TOKEN=               # production only: secret code needed on the browser setup page to create the first admin
# CORS_ORIGINS=              # only if the public website is hosted on a DIFFERENT domain
# ALLOW_EPHEMERAL_STORAGE=   # "true" = allow Render WITHOUT a disk (throw-away demo only; data WILL be lost)
